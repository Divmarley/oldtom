# Published production images
# For repeatable deployments, replace latest tags with a release tag or digest.
BACKEND_IMAGE=marleyk/oldtoms:backend-latest
FRONTEND_IMAGE=marleyk/oldtoms:frontend-latest
HTTP_PORT=80
PHPMYADMIN_PORT=8080

# Django production settings
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=example.com,www.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# Enable these only when every subdomain is permanently HTTPS-only and you
# understand the browser HSTS preload requirements.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Public website URLs used inside emails
SITE_NAME=Old Toms - Class of 2016
SITE_URL=https://example.com
EMAIL_LOGO_URL=https://example.com/logo.jpg
EMAIL_SUPPORT_ADDRESS=info@example.com
EMAIL_REPLY_TO=events@example.com

# SMTP credentials (example uses STARTTLS on port 587)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Old Toms <noreply@example.com>
SERVER_EMAIL=Old Toms Server <server@example.com>
LOGIN_EMAIL_NOTIFICATIONS=true
WELCOME_EMAIL_NOTIFICATIONS=true
EVENT_REGISTRATION_THROTTLE_RATE=5/hour
LOGIN_THROTTLE_RATE=10/minute
ACCOUNT_REGISTRATION_THROTTLE_RATE=30/hour
# Use 2 when a load balancer or CDN sits in front of the included Nginx proxy.
TRUSTED_PROXY_COUNT=1

# MySQL
DB_NAME=oldtom
DB_USER=oldtom_user
DB_PASSWORD=replace-with-database-password
DB_HOST=mysql
DB_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-root-database-password

# Vite embeds this value at frontend image build time
VITE_API_BASE_URL=/api
