# Published production images
# For repeatable deployments, replace latest tags with a release tag or digest.
BACKEND_IMAGE=marleyk/oldtoms:backend-latest
FRONTEND_IMAGE=marleyk/oldtoms:frontend-latest
# Certbot 5.8.0, pinned to the image tested with this deployment setup.
CERTBOT_IMAGE=certbot/certbot@sha256:f70ad0adbb7e117f0fe42a63c553f28ea451edabc0148757b6efcd9735acaa20
# The production Compose override defaults to /opt/oldtom/oldtom.env.
# Set APP_ENV_FILE only when the server stores this file somewhere else.
# APP_ENV_FILE=/custom/path/oldtom.env
# Direct TLS is enabled by docker-compose.production.yml. DOMAIN must resolve
# to this server before the initial Let's Encrypt certificate is requested.
DOMAIN=example.com
# Optional space-separated SANs, for example: www.example.com
ADDITIONAL_DOMAINS=www.example.com
CERTBOT_EMAIL=admin@example.com
# Keep these at 80/443 for direct TLS. Different host ports require an
# upstream NAT/load balancer that still forwards public ports 80 and 443.
HTTP_PORT=80
HTTPS_PORT=443
PHPMYADMIN_BIND_IP=127.0.0.1
PHPMYADMIN_PORT=8080

# Django production settings
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=example.com,www.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
# Nginx is the public TLS endpoint and sends this header consistently for the
# frontend, API, static files, and media. Add `; includeSubDomains; preload`
# only after all subdomains meet the browser HSTS preload requirements.
HSTS_HEADER_VALUE=max-age=31536000
# Keep Django's duplicate HSTS response disabled; Nginx strips it from proxied
# responses and is the single public owner of this header.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Public website URLs used inside emails
SITE_NAME=Old Toms - Class of 2016
SITE_URL=https://example.com
EMAIL_LOGO_URL=https://example.com/logo.jpg
EMAIL_SUPPORT_ADDRESS=info@example.com
EMAIL_REPLY_TO=events@example.com

# SMTP credentials (example uses STARTTLS on port 587)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Old Toms <noreply@example.com>
SERVER_EMAIL=Old Toms Server <server@example.com>
LOGIN_EMAIL_NOTIFICATIONS=true
WELCOME_EMAIL_NOTIFICATIONS=true
EVENT_REGISTRATION_THROTTLE_RATE=5/hour
LOGIN_THROTTLE_RATE=10/minute
ACCOUNT_REGISTRATION_THROTTLE_RATE=30/hour
# Keep this at 1 for direct Nginx TLS. Before increasing it for a CDN/load
# balancer, restrict origin access to trusted proxy IP ranges and configure the
# forwarded-address trust chain; otherwise clients can forge forwarded IPs.
TRUSTED_PROXY_COUNT=1

# MySQL
DB_NAME=oldtom
DB_USER=oldtom_user
DB_PASSWORD=replace-with-database-password
DB_HOST=mysql
DB_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-root-database-password

# Vite embeds this value at frontend image build time
VITE_API_BASE_URL=/api
